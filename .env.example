# =============================================================================
# fin-trade — Environment Variables & API Key Template
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# IMPORTANT:
#   * `.env` is listed in .gitignore — NEVER commit real keys to git.
#   * Every variable below is OPTIONAL for paper-only research. The system
#     degrades gracefully: a source with no configured key is skipped with a
#     warning (yfinance and the FRED public CSV endpoints need no key at all).
#   * config.yaml references these as ${NAME} placeholders.
# =============================================================================

# ---------------------------------------------------------------------------
# Market / fundamental data providers
# ---------------------------------------------------------------------------
# Alpha Vantage — free tier: 25 requests/day.
# Get a key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=""

# Finnhub — free tier: 60 calls/minute. Used for news + sentiment.
# Get a key: https://finnhub.io/register
FINNHUB_KEY=""

# Polygon.io — aggregates/tick/options data. Free tier available.
# Get a key: https://polygon.io/dashboard/signup
POLYGON_KEY=""

# NewsAPI — supplementary headlines. Free developer tier.
# Get a key: https://newsapi.org/register
NEWSAPI_KEY=""

# ---------------------------------------------------------------------------
# Macroeconomic data
# ---------------------------------------------------------------------------
# Federal Reserve Economic Data (FRED). Without a key the agent falls back to
# the public fredgraph CSV endpoints; a key unlocks the official API.
# Get a key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=""

# ---------------------------------------------------------------------------
# SEC EDGAR (insider filings, 13F). No key required, but SEC policy demands a
# descriptive User-Agent with a contact email.
# ---------------------------------------------------------------------------
SEC_EDGAR_USER_AGENT="fin-trade research agent (you@example.com)"

# ---------------------------------------------------------------------------
# Social sentiment (disabled by default in config.yaml)
# ---------------------------------------------------------------------------
# Reddit — create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_SECRET=""
REDDIT_USER_AGENT="fin-trade/1.0 by u/your_username"

# Twitter/X — bearer token from https://developer.twitter.com/
TWITTER_BEARER=""

# ---------------------------------------------------------------------------
# Broker — Alpaca (RECOMMENDED; has a built-in paper environment)
# ---------------------------------------------------------------------------
# Paper trading keys: https://app.alpaca.markets/paper/dashboard/overview
# !!! Use PAPER keys only until the 90-day paper validation checklist passes.
ALPACA_KEY=""
ALPACA_SECRET=""
# Leave empty to use the default paper endpoint set in config.yaml
# (https://paper-api.alpaca.markets). NEVER point this at the live endpoint
# unless you are deliberately enabling live trading.
ALPACA_BASE_URL=""

# Interactive Brokers (Phase 10+). Host/port of a locally running TWS or
# IB Gateway instance with API access enabled.
IBKR_HOST="127.0.0.1"
IBKR_PORT="7497"          # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper
IBKR_CLIENT_ID="1"

# ---------------------------------------------------------------------------
# Notifications (all optional)
# ---------------------------------------------------------------------------
# SMTP email alerts
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_EMAIL_FROM=""
ALERT_EMAIL_TO=""

# Telegram alerts — create a bot via @BotFather, get chat id via @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Twilio SMS alerts
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_TO_NUMBER=""

# ---------------------------------------------------------------------------
# Runtime overrides
# ---------------------------------------------------------------------------
# Path to the master config file (defaults to ./config.yaml)
FIN_TRADE_CONFIG=""

# Force trading mode override used by safety checks. Leave EMPTY in normal
# operation; the dashboard/CLI set this explicitly when switching modes.
# Allowed: paper | live | shadow
FIN_TRADE_MODE_OVERRIDE=""

# Explicit, typed authorization required before ANY live order can be sent.
# Must be exactly: I-UNDERSTAND-LIVE-TRADING-RISK
FIN_TRADE_LIVE_AUTHORIZATION=""
